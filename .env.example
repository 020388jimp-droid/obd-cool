# ============================================================
# OBD COOL — variables de entorno
# Copia este archivo a .env y rellena lo que necesites.
# NUNCA subas .env a GitHub.
# ============================================================

# URL del proxy de IA (Cloudflare Worker). En local, Vite lo redirige
# automáticamente a http://127.0.0.1:8787 con `npm run worker:dev`.
# En producción usa la URL de tu Worker, por ejemplo:
# VITE_AI_ENDPOINT=https://obd-cool-ai.TU-USUARIO.workers.dev/api/diagnose
VITE_AI_ENDPOINT=/api/diagnose

# Portal de reparación. Puedes cambiarlo sin tocar código.
VITE_IFIX_BASE_URL=https://es.ifixit.com/Device/Car_and_Truck

# Nombre visible de la marca
VITE_APP_NAME=OBD COOL

# ------------------------------------------------------------
# Solo para el Worker (NO van en el frontend)
# Configúralas con `wrangler secret put GEMINI_API_KEY`
# ------------------------------------------------------------
# GEMINI_API_KEY=tu_clave_de_google_ai_studio
# GEMINI_MODEL=gemini-2.5-flash
# ALLOWED_ORIGINS=https://tu-usuario.github.io,http://localhost:5173
# RATE_LIMIT_PER_MINUTE=8
