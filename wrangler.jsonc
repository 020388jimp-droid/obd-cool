{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obd-cool-ai",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
